# ============================================================
# HoyoLab Check-in Service - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER share or commit your .env file!

# ---- HoyoLab Account Cookies (required) ----
# Get these from your browser's developer tools after logging in to hoyolab.com
# Open DevTools (F12) > Application > Cookies > https://www.hoyolab.com
LTUID_V2=your_ltuid_v2_here
LTOKEN_V2=your_ltoken_v2_here
COOKIE_TOKEN_V2=your_cookie_token_v2_here
ACCOUNT_ID_V2=your_account_id_v2_here

# ---- Games to check-in (set to true/false) ----
ENABLE_GENSHIN=true
ENABLE_STARRAIL=true
ENABLE_ZZZ=true
ENABLE_HONKAI3RD=false
ENABLE_TOT=false

# ---- Scheduler Settings ----
# Cron expression for check-in time (default: midnight 00:00 every day)
# Format: "second minute hour day month weekday"
CRON_SCHEDULE=0 0 0 * * *

# Timezone (Asia/Kuala_Lumpur for MYT, Asia/Singapore for SGT, UTC for UTC)
TIMEZONE=Asia/Kuala_Lumpur

# ---- Optional: Discord Webhook Notifications ----
# Leave blank to disable notifications
DISCORD_WEBHOOK_URL=

# ---- Optional: Telegram Notifications ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Logging ----
LOG_LEVEL=info
LOG_TO_FILE=true
