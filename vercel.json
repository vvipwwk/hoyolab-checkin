{
  "crons": [
    {
      "path": "/api/checkin",
      "schedule": "0 16 * * *"
    }
  ],
  "functions": {
    "api/checkin.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/public/(.*)",
      "destination": "/public/$1"
    }
  ]
}
